generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// 사용자
// ============================================

enum UserRole {
  CUSTOMER
  EXPERT
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  image     String?
  roles     UserRole[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerProfile CustomerProfile?
  expertProfile   ExpertProfile?
  requests        ServiceRequest[]
  quotes          Quote[]
  jobs            Job[]          @relation("CustomerJobs")
  expertJobs      Job[]          @relation("ExpertJobs")
  reviews         Review[]       @relation("ReviewAuthor")
  receivedReviews Review[]       @relation("ReviewTarget")
  notifications   Notification[]
  uploadSessions  UploadSession[]
}

model CustomerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExpertProfile {
  id          String  @id @default(uuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id])
  displayName String
  bio         String?
  yearsOfExp  Int     @default(0)
  responseRate Float  @default(0)
  avgRating   Float   @default(0)
  reviewCount Int     @default(0)
  isPublic    Boolean @default(false)

  categories  ExpertCategory[]
  areas       ExpertArea[]
  portfolio   PortfolioItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExpertCategory {
  id              String        @id @default(uuid())
  expertProfileId String
  expertProfile   ExpertProfile @relation(fields: [expertProfileId], references: [id])
  categoryId      String
  category        ServiceCategory @relation(fields: [categoryId], references: [id])

  @@unique([expertProfileId, categoryId])
}

model ExpertArea {
  id              String        @id @default(uuid())
  expertProfileId String
  expertProfile   ExpertProfile @relation(fields: [expertProfileId], references: [id])
  region          String

  @@unique([expertProfileId, region])
}

model PortfolioItem {
  id              String        @id @default(uuid())
  expertProfileId String
  expertProfile   ExpertProfile @relation(fields: [expertProfileId], references: [id])
  title           String
  description     String?
  imageUrl        String
  sortOrder       Int           @default(0)

  createdAt DateTime @default(now())
}

// ============================================
// 서비스 카테고리
// ============================================

model ServiceCategory {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  iconUrl     String?
  sortOrder   Int     @default(0)

  experts  ExpertCategory[]
  requests ServiceRequest[]

  createdAt DateTime @default(now())
}

// ============================================
// 요청서
// ============================================

enum RequestStatus {
  DRAFT
  OPEN
  CLOSED
  EXPIRED
}

model ServiceRequest {
  id          String        @id @default(uuid())
  customerId  String
  customer    User          @relation(fields: [customerId], references: [id])
  categoryId  String
  category    ServiceCategory @relation(fields: [categoryId], references: [id])
  title       String
  description String
  location    String?
  latitude    Float?
  longitude   Float?
  budget      String?
  schedule    String?
  status      RequestStatus @default(DRAFT)
  expiresAt   DateTime?

  answers ServiceRequestAnswer[]
  quotes  Quote[]
  jobs    Job[]
  images  Asset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceRequestAnswer {
  id        String         @id @default(uuid())
  requestId String
  request   ServiceRequest @relation(fields: [requestId], references: [id])
  question  String
  answer    String

  createdAt DateTime @default(now())
}

// ============================================
// 견적
// ============================================

enum QuoteStatus {
  SUBMITTED
  REVISED
  ACCEPTED
  DECLINED
  EXPIRED
}

model Quote {
  id         String      @id @default(uuid())
  requestId  String
  request    ServiceRequest @relation(fields: [requestId], references: [id])
  expertId   String
  expert     User        @relation(fields: [expertId], references: [id])
  title      String
  message    String
  price      Int
  priceMax   Int?
  duration   String?
  canVisit   Boolean     @default(false)
  status     QuoteStatus @default(SUBMITTED)

  job Job?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requestId, expertId])
}

// ============================================
// 작업 (Job)
// ============================================

enum JobStatus {
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Job {
  id         String    @id @default(uuid())
  requestId  String
  request    ServiceRequest @relation(fields: [requestId], references: [id])
  quoteId    String    @unique
  quote      Quote     @relation(fields: [quoteId], references: [id])
  customerId String
  customer   User      @relation("CustomerJobs", fields: [customerId], references: [id])
  expertId   String
  expert     User      @relation("ExpertJobs", fields: [expertId], references: [id])
  status     JobStatus @default(CONFIRMED)

  review Review?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
}

// ============================================
// 리뷰
// ============================================

enum ReviewStatus {
  VISIBLE
  HIDDEN
}

model Review {
  id       String       @id @default(uuid())
  jobId    String       @unique
  job      Job          @relation(fields: [jobId], references: [id])
  authorId String
  author   User         @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetId String
  target   User         @relation("ReviewTarget", fields: [targetId], references: [id])
  rating   Int
  comment  String
  tags     String[]
  status   ReviewStatus @default(VISIBLE)

  createdAt DateTime @default(now())
}

// ============================================
// 알림
// ============================================

enum NotificationType {
  NEW_QUOTE
  NEW_MESSAGE
  JOB_CONFIRMED
  JOB_COMPLETED
  REVIEW_REQUEST
}

model Notification {
  id     String           @id @default(uuid())
  userId String
  user   User             @relation(fields: [userId], references: [id])
  type   NotificationType
  title  String
  body   String
  linkTo String?
  isRead Boolean          @default(false)

  createdAt DateTime @default(now())
}

// ============================================
// 에셋 / 업로드
// ============================================

model Asset {
  id        String          @id @default(uuid())
  requestId String?
  request   ServiceRequest? @relation(fields: [requestId], references: [id])
  url       String
  mimeType  String
  sizeBytes Int
  sortOrder Int             @default(0)

  createdAt DateTime @default(now())
}

model UploadSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  key       String
  expiresAt DateTime

  createdAt DateTime @default(now())
}
